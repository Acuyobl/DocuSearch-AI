{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Json": true
  },
  "AllowedHosts": "docs.example.internal",
  "ConnectionStrings": {
    "Documents": "Server=sql.example.internal;Database=DocuSearch;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;Connect Timeout=8"
  },
  "Demo": {
    "LocalOnly": false,
    "AllowReset": false,
    "SeedOnInitialize": false,
    "AllowInsecureExposure": false
  },
  "Security": {
    "Https": {
      "Enabled": true
    },
    "ContentSecurityPolicy": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ws: wss:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'",
    "LoginRateLimitPerMinute": 10,
    "ForwardedHeaders": {
      "Enabled": true,
      "KnownProxies": [ "10.0.0.10" ]
    }
  },
  "Auth": {
    "SessionHours": 8,
    "TotpWindow": 1,
    "EnrollmentEnabled": false,
    "MaxFailedAttempts": 10,
    "LockoutMinutes": 5,
    "Issuer": "DocuSearch AI",
    "Users": [
      {
        "Email": "admin@example.internal",
        "Name": "Administrador",
        "Role": "admin_general",
        "Department": "Tecnología & TI"
      }
    ],
    "TotpSecrets": {}
  },
  "Assistant": {
    "DefaultProfile": "paid:deepseek/deepseek-flash",
    "MaxFreeModels": 40,
    "MaxPaidModels": 10,
    "MaxLocalModels": 20,
    "IncludeFreeModels": false,
    "IncludeLocalModels": false,
    "UseLangGraph": false,
    "LangGraphTimeoutSeconds": 90,
    "LangGraphMaxSources": 4,
    "LangGraphMaxRetries": 1
  },
  "Observability": {
    "RetentionDays": 90
  },
  "Embeddings": {
    "Enabled": true,
    "Provider": "pinecone",
    "BaseUrl": "https://api.pinecone.io",
    "ApiKey": "",
    "Model": "multilingual-e5-large",
    "Dimensions": 1024,
    "TimeoutSeconds": 60,
    "BatchSize": 32,
    "MaxChars": 8000
  },
  "Pinecone": {
    "Enabled": false,
    "ApiKey": "",
    "IndexName": "docusearch-rag",
    "Namespace": "docusearch",
    "Dimension": 1024,
    "TopK": 12,
    "MinScore": 0.35,
    "TimeoutSeconds": 30,
    "ApiVersion": "2024-07"
  },
  "Rag": {
    "ChunkingStrategy": "fixed",
    "MaxTokens": 300,
    "OverlapTokens": 60,
    "SemanticBreakThreshold": 0.55,
    "CandidateK": 30,
    "TopK": 16,
    "VectorWeight": 0.65,
    "LexicalWeight": 0.35,
    "Rerank": true,
    "RerankCandidates": 16,
    "RerankerUrl": "http://127.0.0.1:4098",
    "RerankerTimeoutSeconds": 60,
    "VectorStore": "sql",
    "AuditContent": true,
    "UseChunkPipeline": true
  },
  "Resilience": {
    "MaxAttempts": 3,
    "BaseDelayMs": 400,
    "MaxDelayMs": 5000,
    "FailureThreshold": 5,
    "BreakSeconds": 60,
    "AttemptTimeoutSeconds": 75
  },
  "OpenCode": {
    "Enabled": true,
    "BaseUrl": "http://127.0.0.1:4097",
    "Username": "opencode",
    "Agent": "",
    "ProviderId": "deepseek",
    "ModelId": "deepseek-flash",
    "TimeoutSeconds": 120,
    "UseLangChain": true,
    "AllowNonLoopback": false
  },
  "AiGovernance": {
    "UsdPer1kInput": 0,
    "UsdPer1kOutput": 0,
    "Pricing": {}
  },
  "Governance": {
    "ApprovalsEnabled": false,
    "SensitiveActions": [ "DELETE_DOCUMENT", "DOWNGRADE_CONFIDENTIALITY", "USER_ROLE_CHANGE", "DELETE_USER", "RESET", "PURGE_TRACES" ],
    "ApprovalExpiryHours": 72,
    "SchedulerEnabled": false,
    "SchedulerTickSeconds": 60,
    "RoutineHistoryDays": 90
  }
}
