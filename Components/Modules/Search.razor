@inject WorkspaceState State
@inject DocumentService Service
@inject EmbeddingClient Embeddings
@inject PineconeRetriever Pinecone
@inject IRagRetriever Retrieval
@inject AssistantMemory Memory
@inject LocalSession Session
@inject Microsoft.Extensions.Options.IOptions<RagOptions> RagOptions
<div class="module-page smart-search">
<div class="segmented-control search-modes" role="group" aria-label="Herramientas del buscador">
    <button type="button" aria-pressed="@showAssistant" aria-controls="search-assistant" class="@(showAssistant ? "active" : "")" @onclick="() => SelectAssistant(true)"><AppIcon Name="agent" />Asistente IA</button>
    <button type="button" aria-pressed="@(!showAssistant)" aria-controls="document-search" class="@(!showAssistant ? "active" : "")" @onclick="() => SelectAssistant(false)"><AppIcon Name="search" />Buscar documentos</button>
</div>
<div id="document-search" hidden="@showAssistant">
<div class="module-page">
<header class="search-hero">
    <span class="module-kicker"><AppIcon Name="search" />Búsqueda Híbrida (léxica + semántica) &amp; Texto Exacto</span>
    <h1>Exploración Inteligente del Contenido Documental</h1>
    <p>Localiza conceptos clave, cláusulas y fragmentos específicos con fuentes verificables por página.</p>
    <div class="segmented-control" aria-label="Modo de búsqueda"><button type="button" aria-pressed="@(!exact)" class="@(!exact ? "active" : "")" @onclick="() => SetMode(false)"><AppIcon Name="agent" />Lenguaje Natural (híbrida)</button><button type="button" aria-pressed="@exact" class="@(exact ? "active" : "")" @onclick="() => SetMode(true)"><AppIcon Name="search" />Coincidencia Textual Exacta</button></div>
    <form @onsubmit="Execute" @onsubmit:preventDefault>
        <div class="central-search"><AppIcon Name="search" /><input aria-label="Consulta documental" maxlength="2000" placeholder="Pregunta o busca algo (ej. SLA 99.99%, ISO 27001, EBITDA)…" @bind="query" /><button class="primary" disabled="@State.Busy">Buscar</button></div>
    </form>
    <div class="suggestions">
        <small>Sugerencias rápidas:</small>
        @foreach (var suggestion in new[] { "SLA 99.99%", "ISO 27001 contraseñas", "EBITDA Q4 2024", "Teletrabajo" })
        { <button disabled="@State.Busy" @onclick="() => Suggest(suggestion)">@suggestion</button> }
    </div>
    @if (history.Count > 0)
    {
        <div class="suggestions"><small>Recientes:</small>@foreach (var recent in history) { <button @onclick="() => Suggest(recent)">@recent</button> }<button class="link-button" title="Borrar la búsqueda y el historial de esta sesión" @onclick="ClearHistory"><AppIcon Name="delete" />Borrar</button></div>
    }
</header>
<section class="panel search-panel">
    <div class="section-heading"><strong><AppIcon Name="search" />Filtros de exploración</strong><label class="inline">Relevancia mínima <input type="number" min="1" max="100" @bind="minimum" @bind:after="RefilterAsync" /> %</label></div>
    <DocumentFilters Filter="filter" ShowText="false" OnChanged="RefilterAsync" />
</section>
<div class="section-heading"><h2>@results.Count fragmento(s)</h2><span class="badge">@(exact ? "Texto exacto" : "Relevancia híbrida") · @elapsed ms</span></div>
@foreach (var hit in results.Take(limit))
{
    <article class="panel result">
        <div class="section-heading"><span class="code">@hit.Document.InternalCode · página @hit.PageNumber</span><span class="badge success">@hit.Score%</span></div>
        <h3><AppIcon Name="document" />@hit.Document.Title</h3><p class="result-snippet">@hit.Snippet</p>
        <div class="section-heading"><small>@hit.Document.Department · @hit.Document.Category · @hit.Document.Confidentiality</small><button @onclick="() => OnView.InvokeAsync(hit)"><AppIcon Name="eye" />Abrir fuente →</button></div>
    </article>
}
@if (results.Count == 0) { <div class="panel empty">Sin coincidencias. Prueba otros términos o ajusta los filtros.</div> }
@if (results.Count > limit) { <button @onclick="() => limit += 20">Mostrar más resultados</button> }
</div>
</div>
<div id="search-assistant" hidden="@(!showAssistant)">
    @if (assistantOpened)
    {
        <AgentChat OnView="OnView" />
    }
</div>
</div>
@code {
    [Parameter] public EventCallback<SearchHit> OnView { get; set; }
    [Parameter] public bool OpenAssistant { get; set; }
    private bool showAssistant;
    private bool assistantOpened;
    private bool? previousOpenAssistant;
    private readonly DocumentFilter filter = new();
    private string query = "";
    private bool exact;
    private int minimum = 10;
    private int limit = 20;
    private long elapsed;
    private float[]? queryVector;
    private IReadOnlyDictionary<(string DocumentId, int PageNumber), double>? externalScores;
    private List<SearchHit> results = [];
    private readonly List<string> history = [];
    protected override async Task OnInitializedAsync()
    {
        // Al volver a la página se recupera la última búsqueda de esta sesión (24 h como máximo).
        if (Memory.GetSearch(Session) is { } saved)
        {
            query = saved.Query;
            exact = saved.Exact;
            minimum = saved.Minimum;
            filter.Department = saved.Department;
            filter.Category = saved.Category;
            filter.Level = saved.Level;
            filter.Year = saved.Year;
            history.AddRange(saved.History);
            if (!string.IsNullOrWhiteSpace(query))
            {
                try { await RefreshQuerySignals(); }
                catch (Exception ex) when (ex is not OperationCanceledException) { queryVector = null; externalScores = null; }
            }
        }
        await RefilterAsync();
    }
    private void Remember() => Memory.SaveSearch(Session, new SearchMemory(query, exact, minimum,
        filter.Department, filter.Category, filter.Level, filter.Year, history.ToList()));
    private async Task ClearHistory()
    {
        history.Clear();
        query = "";
        queryVector = null;
        externalScores = null;
        Memory.ClearSearch(Session);
        await RefilterAsync();
    }
    protected override void OnParametersSet()
    {
        if (previousOpenAssistant == OpenAssistant) return;
        previousOpenAssistant = OpenAssistant;
        SelectAssistant(OpenAssistant);
    }
    private void SelectAssistant(bool value)
    {
        showAssistant = value;
        assistantOpened |= value;
    }

    /// <summary>Control externo para la página /web: abre el asistente.</summary>
    public Task ShowAssistantAsync() => InvokeAsync(() =>
    {
        SelectAssistant(true);
        StateHasChanged();
    });

    /// <summary>Control externo para la página /web: abre la búsqueda documental.</summary>
    public Task ShowDocumentsAsync() => InvokeAsync(() =>
    {
        SelectAssistant(false);
        StateHasChanged();
    });
    private async Task SetMode(bool value)
    {
        exact = value;
        await RefreshQuerySignals();
        await RefilterAsync();
    }
    private async Task RefreshQuerySignals()
    {
        queryVector = exact || string.IsNullOrWhiteSpace(query) ? null : await Embeddings.TryEmbedAsync(query);
        externalScores = queryVector is null || !Pinecone.Enabled
            ? null
            : await Pinecone.SearchAsync(queryVector, State.Data!.Documents.Select(document => document.Id).ToList());
    }
    private async Task RefilterAsync()
    {
        try { await FilterCoreAsync(); }
        finally { if (Session.IsAuthenticated) Remember(); }
    }
    private async Task FilterCoreAsync()
    {
        var timer = System.Diagnostics.Stopwatch.StartNew();
        if (RagOptions.Value.UseChunkPipeline && !exact && !string.IsNullOrWhiteSpace(query) && queryVector is not null)
        {
            try
            {
                var documents = filter.Apply(State.Data!.Documents).ToList();
                var hits = await Retrieval.RetrieveAsync(query, queryVector,
                    documents.Select(document => document.Id).ToList());
                // Sin candidatos (p. ej. expedientes aún sin indexar por fragmentos) se usa el índice anterior.
                if (hits.Count > 0)
                {
                    results = hits.Select(hit =>
                    {
                        var document = documents.FirstOrDefault(item => item.Id == hit.Chunk.DocumentId);
                        if (document is null || document.Pages.All(page => page.PageNumber != hit.Chunk.PageNumber)) return null;
                        return new SearchHit(document, hit.Chunk.PageNumber, hit.Chunk.Text,
                            Math.Clamp((int)Math.Round(hit.Score * 100), 0, 100));
                    }).Where(hit => hit is not null && hit.Score >= Math.Clamp(minimum, 1, 100))
                        .Select(hit => hit!).ToList();
                    elapsed = timer.ElapsedMilliseconds;
                    limit = 20;
                    return;
                }
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                // Si el pipeline nuevo falla, se usa el índice anterior.
            }
        }
        results = LocalSearch.Search(filter.Apply(State.Data!.Documents), query, exact, Math.Clamp(minimum, 1, 100),
            queryVector, externalScores);
        elapsed = timer.ElapsedMilliseconds;
        limit = 20;
    }
    private Task Execute() => State.RunAsync(async () =>
    {
        if (query.Length > 2000) throw new ValidationException("La consulta admite hasta 2000 caracteres.");
        await State.RefreshAsync();
        await RefreshQuerySignals();
        await Service.LogQueryAsync("SEARCH", $"{(exact ? "Exacta" : "Híbrida")}: {query}");
        if (!string.IsNullOrWhiteSpace(query))
        {
            history.Remove(query);
            history.Insert(0, query);
            if (history.Count > 5) history.RemoveAt(5);
        }
        await RefilterAsync();
    });
    private Task Suggest(string value) { query = value; return Execute(); }
}
