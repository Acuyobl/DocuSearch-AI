@inject WorkspaceState State
@inject LocalAgent Agent
@inject IJSRuntime JS
@inject OpenCodeClient OpenCode
@inject AssistantRuntime Runtime
@inject RagQueryService Rag
@inject AssistantMemory Memory
@inject Microsoft.Extensions.Options.IOptions<DocuSearch.Services.Rag.RagOptions> RagOptions
@implements IAsyncDisposable
<div class="assistant-page">
<header class="assistant-bar">
    <div class="assistant-title">
        <span class="assistant-mark"><AppIcon Name="agent" /></span>
        <div>
            <h2>Asistente documental</h2>
            <small>@State.Data!.Documents.Count expedientes · acceso hasta «@Permissions.ReadableLevels(State.Data.Actor).Last()» · solo lectura</small>
        </div>
    </div>
    <div class="assistant-actions">
        <span class="engine-status @(modelVerified ? "ok" : "warn")" title="@EngineLabel"><span class="status-dot"></span>@EngineShort</span>
        @if (CanSelectProfile)
        {
            <select @bind="selectedProfile" @bind:after="ApplyProfile" disabled="@State.Busy" aria-label="Motor del asistente (afecta a todas las consultas)" title="Motor del asistente (solo administración general)">
                @foreach (var group in Runtime.Profiles.GroupBy(profile => profile.Group))
                {
                    <optgroup label="@group.Key">
                        @foreach (var profile in group)
                        {
                            <option value="@profile.Id">@profile.Label</option>
                        }
                    </optgroup>
                }
            </select>
        }
        <button class="agent-status-button @(lastAgents.Count > 1 ? "multi" : "") @(State.Busy ? "running" : "")" @onclick="OpenAgentPanel" aria-haspopup="dialog" title="Ver agentes que intervinieron en la última respuesta" aria-expanded="@(agentsOpen ? "true" : "false")">
            <span class="agent-lights" aria-hidden="true">@foreach (var code in AgentCodes) { <i class="@(IsAgentActive(code) || State.Busy ? "on" : "") @AgentTone(code)"></i> }</span>
            <span>@(State.Busy ? "Ejecutando agentes…" : lastAgents.Count switch { 0 => "Agentes", 1 => "1 agente", _ => $"{lastAgents.Count} agentes" })</span>
        </button>
        <button class="icon-button" disabled="@State.Busy" @onclick="CheckConnection" title="Comprobar motores y actualizar documentos" aria-label="Comprobar motores y actualizar documentos"><AppIcon Name="refresh" /></button>
        <button class="icon-button" @onclick="Clear" disabled="@(State.Busy || messages.Count == 0)" title="Nueva conversación" aria-label="Nueva conversación"><AppIcon Name="delete" /></button>
    </div>
</header>
@if (Runtime.LastError is not null)
{
    <div class="alert error" role="alert">@Runtime.LastError</div>
}
else if (!Active.Available)
{
    <div class="alert error" role="alert">El modelo «@Active.Label» está configurado pero su proveedor no está conectado. Revisa la conexión y vuelve a comprobar los motores.</div>
}
<dialog id="agent-dialog" @ref="agentDialog" class="agent-dialog" aria-label="Agentes de la última respuesta" closedby="any" @onclose="OnAgentDialogClosed">
    <section class="agent-panel @(State.Busy ? "running" : "")" aria-label="Agentes de la última respuesta">
        <div class="agent-panel-head">
            <div><strong>@(State.Busy ? "Pipeline en ejecución" : "Agentes de la última respuesta")</strong><span>@lastProvider</span></div>
            <button class="icon-button" @onclick="CloseAgentPanel" aria-label="Cerrar panel de agentes"><AppIcon Name="close" /></button>
        </div>
        <div class="agent-panel-grid">
            @foreach (var code in AgentCodes)
            {
                var active = IsAgentActive(code) || State.Busy;
                <div class="agent-run-card @(active ? "on" : "") @AgentTone(code)">
                    <span class="agent-status-light @(active ? "on" : "") @AgentTone(code)"></span>
                    <div><strong>@AgentLabel(code)</strong><small>@AgentDescription(code)</small></div>
                    <em>@(State.Busy ? "ejecutando" : active ? "activo" : "en espera")</em>
                </div>
            }
        </div>
        <p class="agent-panel-note">@(lastAgents.Count > 1 ? "Esta respuesta usó varios agentes coordinados por LangGraph." : "Las luces indican qué agentes intervinieron en la última consulta.")</p>
    </section>
</dialog>
<section class="conversation" @ref="conversation" aria-label="Conversación documental" aria-live="polite">
    @if (messages.Count == 0)
    {
        <div class="assistant-empty"><AppIcon Name="agent" /><p>¿Qué necesitas consultar en tus expedientes?</p></div>
    }
    @foreach (var message in messages)
    {
        @if (message.IsUser)
        {
            <article class="chat-turn user"><div class="message"><div class="preserve">@message.Text</div></div></article>
        }
        else
        {
            <article class="chat-turn assistant">
                <span class="chat-avatar"><AppIcon Name="agent" /></span>
                <div class="message">
                    <div class="answer-meta">
                        <span>Asistente</span>
                        @if (!string.IsNullOrWhiteSpace(message.Provider))
                        {
                            <span class="answer-engine">@message.Provider</span>
                        }
                        @if (message.AgentList.Count > 0)
                        {
                            <span class="agent-indicator @(message.AgentList.Count > 1 ? "multi" : "single")" title="@AgentNames(message.AgentList)">
                                <span class="agent-lights" aria-hidden="true">@foreach (var code in AgentCodes) { <i class="@(IsAgentActive(message.AgentList, code) ? "on" : "") @AgentTone(code)"></i> }</span>
                                @message.AgentList.Count @(message.AgentList.Count == 1 ? "agente" : "agentes")
                            </span>
                        }
                        <time>@message.At.ToLocalTime().ToString("HH:mm")</time>
                    </div>
                    <ChatAnswer Text="@message.Text" Sources="message.Sources" NumberedSources="message.Numbered" Documents="State.Data.Documents" OnView="OnView" />
                    @if (message.Sources.Count > 0)
                    {
                        <button class="link-button" @onclick="() => DownloadPdf(message)" title="Descargar esta respuesta en PDF"><AppIcon Name="download" />Descargar PDF</button>
                    }
                </div>
            </article>
        }
    }
    @if (State.Busy && messages.Count > 0)
    {
        <div class="chat-turn assistant" role="status"><span class="chat-avatar"><AppIcon Name="agent" /></span><div class="message typing"><span></span><span></span><span></span><small>Consultando expedientes…</small></div></div>
    }
</section>
<form class="chat-composer" @onsubmit="Send" @onsubmit:preventDefault>
    <label><span class="visually-hidden">Tu consulta</span><textarea @ref="composer" @bind="query" @bind:event="oninput" maxlength="2000" rows="2" placeholder="Escribe tu pregunta… (Enter envía · Mayús+Enter salta de línea)"></textarea></label>
    <button type="submit" class="primary" aria-label="Consultar" disabled="@(State.Busy || string.IsNullOrWhiteSpace(query))"><AppIcon Name="send" />Consultar</button>
</form>
<small class="assistant-disclaimer">Solo se consultan fuentes autorizadas para tu perfil. @EngineDisclaimer
    @if (expiresUtc is { } expires) { <span class="memory-note"><AppIcon Name="lock" />Conversación guardada en esta sesión hasta el @expires.ToLocalTime().ToString("dd/MM HH:mm"); se borra al cerrar sesión o con «Nueva conversación».</span> }</small>
</div>
@code {
    [Parameter] public EventCallback<SearchHit> OnView { get; set; }
    [Inject] private LocalSession Session { get; set; } = default!;
    private string query = "";
    private string selectedProfile = "";
    private bool agentsOpen;
    private IReadOnlyList<string> lastAgents = [];
    private string lastProvider = "";
    private static readonly string[] AgentCodes = ["AG-03", "AG-04", "AG-02"];
    private ElementReference conversation;
    private ElementReference composer;
    private ElementReference agentDialog;
    private DotNetObjectReference<AgentChat>? enterBridge;
    private bool scrollPending;
    private bool modelVerified;
    private readonly List<ChatMessage> messages = [];
    private DateTimeOffset? expiresUtc;
    private AssistantProfile Active => Runtime.Active;
    private bool CanSelectProfile => State.Data is { } snapshot && Permissions.CanAdmin(snapshot.Actor);
    private string EngineLabel => Runtime.Describe(Active) + (Active.Available ? "" : " · sin conexión");
    private string EngineShort => Active.Engine.ToLowerInvariant() switch
    {
        "opencode" => string.IsNullOrWhiteSpace(Active.ModelId) ? "OpenCode" : Active.ModelId,
        _ => "Extractivo local"
    } + (modelVerified ? "" : " · sin verificar");
    private string EngineDisclaimer => Active.Engine.ToLowerInvariant() switch
    {
        "opencode" => "La IA puede cometer errores: verifica las citas.",
        _ => "Respuestas extractivas, sin modelo generativo."
    };
    private sealed record ChatMessage(bool IsUser, string Text, List<SearchHit> Sources, string Provider = "", bool Numbered = false,
        string Question = "", IReadOnlyList<string>? Agents = null)
    {
        public IReadOnlyList<string> AgentList => Agents ?? [];
        public DateTimeOffset At { get; init; } = DateTimeOffset.UtcNow;
    }
    protected override async Task OnInitializedAsync()
    {
        RestoreConversation();
        await Runtime.EnsureLoadedAsync();
        selectedProfile = Runtime.Active.Id;
        // La comprobación del motor no debe tumbar el componente si OpenCode no responde:
        // State.RunAsync captura el error y lo muestra en la interfaz.
        await State.RunAsync(CheckActiveEngineCoreAsync);
    }
    private Task CheckConnection() => State.RunAsync(async () =>
    {
        await Runtime.RefreshAsync(force: true);
        if (!Runtime.Profiles.Any(profile => string.Equals(profile.Id, selectedProfile, StringComparison.OrdinalIgnoreCase)))
            selectedProfile = Runtime.Active.Id;
        await CheckActiveEngineCoreAsync();
    });
    private async Task CheckActiveEngineCoreAsync()
    {
        await State.RefreshAsync();
        modelVerified = false;
        if (Runtime.LastError is not null) return;
        switch (Active.Engine.ToLowerInvariant())
        {
            case "opencode":
                if (!OpenCode.Enabled) throw new InvalidOperationException("OpenCode está desactivado en la configuración (OpenCode:Enabled).");
                await OpenCode.CheckAsync(Active.Agent);
                break;
        }
        modelVerified = true;
    }
    private Task ApplyProfile() => State.RunAsync(async () =>
    {
        if (!Runtime.TrySelect(selectedProfile, out _))
            throw new InvalidOperationException("El motor seleccionado ya no existe; pulsa «Actualizar motores» y vuelve a elegir.");
        await CheckActiveEngineCoreAsync();
    }, "Motor del asistente actualizado.");
    /// <summary>
    /// Recupera la conversación de esta sesión al volver a la página. Las fuentes se reconstruyen
    /// con los expedientes que el usuario puede leer ahora: si perdió acceso a alguna, la respuesta
    /// se oculta en lugar de mostrar contenido que ya no le corresponde.
    /// </summary>
    private void RestoreConversation()
    {
        if (State.Data is not { } snapshot) return;
        var saved = Memory.GetConversation(Session);
        expiresUtc = saved.ExpiresUtc;
        messages.Clear();
        foreach (var turn in saved.Turns)
        {
            var sources = new List<SearchHit>();
            var revoked = false;
            foreach (var source in turn.Sources)
            {
                var document = snapshot.Documents.FirstOrDefault(item => item.Id == source.DocumentId);
                if (document is null) { revoked = true; continue; }
                sources.Add(new SearchHit(document, source.PageNumber, source.Snippet, source.Score));
            }
            messages.Add(revoked && !turn.IsUser
                ? new(false, "Respuesta oculta: ya no tienes acceso a alguna de sus fuentes.", [], turn.Provider) { At = turn.At }
                : new(turn.IsUser, turn.Text, sources, turn.Provider, turn.Numbered,
                    Agents: turn.IsUser ? null : AgentsForProvider(turn.Provider)) { At = turn.At });
        }
        if (saved.FocusDocumentCode is not null) Session.LastDocumentCode = saved.FocusDocumentCode;
        scrollPending = messages.Count > 0;
    }
    private void Remember(ChatMessage message) =>
        expiresUtc = Memory.AddTurn(Session, new MemoryTurn(message.IsUser, message.Text, message.Provider, message.Numbered, message.At,
            message.Sources.Select(hit => new MemorySource(hit.Document.Id, hit.PageNumber, TextAnalysis.Truncate(hit.Snippet, 1000), hit.Score)).ToList()));
    private async Task Send()
    {
        if (State.Busy || string.IsNullOrWhiteSpace(query)) return;
        await State.RunAsync(async () =>
        {
            var text = query.Trim();
            // La memoria conversacional se calcula con los turnos anteriores, antes de añadir este.
            var saved = Memory.GetConversation(Session);
            var hint = ConversationContext.Build(text, saved.Turns, saved.FocusDocumentCode ?? Session.LastDocumentCode);
            var userMessage = new ChatMessage(true, text, []);
            messages.Add(userMessage);
            Remember(userMessage);
            query = "";
            scrollPending = true;
            StateHasChanged();
            AgentAnswer answer;
            var numbered = false;
            if (RagOptions.Value.UseChunkPipeline)
            {
                try
                {
                    var rag = await Rag.QueryAsync(text, hint: hint.IsFollowUp ? hint : null);
                    if (rag.Engine == RagQueryService.NoCoverageEngine)
                    {
                        // El índice por fragmentos no cubre la consulta (p. ej. expedientes sin
                        // reindexar): se responde con el RAG anterior en lugar de «sin fuentes».
                        answer = await Agent.AskAsync(text);
                    }
                    else
                    {
                        var sources = rag.Sources
                            .Select(citation => State.Data!.Documents.FirstOrDefault(document =>
                                document.InternalCode.Equals(citation.DocumentCode, StringComparison.OrdinalIgnoreCase)) is { } document
                                ? new SearchHit(document, citation.PageNumber, citation.Text,
                                    Math.Clamp((int)Math.Round(citation.Score * 100), 0, 100))
                                : null)
                            .Where(source => source is not null).Select(source => source!).ToList();
                        answer = new AgentAnswer(rag.Answer, sources, rag.Engine);
                        // Las citas [n] del modelo se numeran sobre las fuentes en este mismo orden.
                        numbered = sources.Count == rag.Sources.Count;
                    }
                }
                catch (Exception ex) when (ex is not OperationCanceledException and not UnauthorizedAccessException)
                {
                    // El pipeline nuevo nunca debe tumbar el asistente; se usa el RAG anterior.
                    answer = await Agent.AskAsync(text);
                }
            }
            else
            {
                answer = await Agent.AskAsync(text);
            }
            var reply = new ChatMessage(false, answer.Text, answer.Sources, answer.Provider, numbered, text,
                AgentsFor(answer));
            messages.Add(reply);
            lastAgents = reply.AgentList;
            lastProvider = reply.Provider;
            Remember(reply);
            if (WantsPdf(text) && answer.Sources.Count > 0)
                await DownloadPdf(reply);
            // El expediente en foco es la fuente principal de la respuesta (o el que fijó el agente local).
            var focus = answer.Sources.FirstOrDefault()?.Document.InternalCode ?? Session.LastDocumentCode;
            if (focus is not null)
            {
                Session.LastDocumentCode = focus;
                Memory.SetFocus(Session, focus);
            }
            scrollPending = true;
            // SendFromEnter se invoca desde JS: sin este render explícito la respuesta
            // se añadía al estado pero el navegador seguía mostrando «Consultando…».
            await InvokeAsync(StateHasChanged);
            await State.RefreshAsync();
        });
        // Render final para reflejar Busy=false cuando el envío vino del puente JS.
        await InvokeAsync(StateHasChanged);
    }
    /// <summary>Enter en el compositor (sin Mayús): el JS intercepta la tecla y envía.</summary>
    private async Task DownloadPdf(ChatMessage message)
    {
        if (message.Sources.Count == 0) return;
        var question = string.IsNullOrWhiteSpace(message.Question) ? message.Text : message.Question;
        var bytes = RagPdfExporter.Build(question, message.Text, message.Sources);
        var slug = new string(TextAnalysis.Normalize(question).Where(char.IsLetterOrDigit).Take(40).ToArray());
        if (slug.Length == 0) slug = "documento";
        var filename = $"docusearch-{slug}-{DateTime.Now:yyyyMMdd-HHmm}.pdf";
        await JS.InvokeVoidAsync("docusearch.downloadBase64", Convert.ToBase64String(bytes), filename, "application/pdf");
    }

    private static IReadOnlyList<string> AgentsFor(AgentAnswer answer) =>
        answer.Agents is { Count: > 0 } listed ? listed : AgentsForProvider(answer.Provider);

    private static IReadOnlyList<string> AgentsForProvider(string provider) =>
        provider.Contains("LangGraph", StringComparison.OrdinalIgnoreCase)
            ? ["AG-03 Recuperador", "AG-04 Redactor", "AG-02 Verificador"]
            : ["AG-04 Redactor"];

    private static string AgentNames(IReadOnlyList<string> agents) =>
        string.Join(" · ", agents.Select(agent =>
            AgentCatalog.Active.FirstOrDefault(info => agent.StartsWith(info.Code, StringComparison.OrdinalIgnoreCase))?.Name
            ?? agent));

    private bool IsAgentActive(string code) => IsAgentActive(lastAgents, code);

    private static bool IsAgentActive(IReadOnlyList<string> agents, string code) =>
        agents.Any(agent => agent.StartsWith(code, StringComparison.OrdinalIgnoreCase));

    private static string AgentLabel(string code) =>
        AgentCatalog.Active.FirstOrDefault(agent => agent.Code == code)?.Name ?? code;

    private static string AgentTone(string code) => code switch
    {
        "AG-03" => "agent-tone-03",
        "AG-04" => "agent-tone-04",
        "AG-02" => "agent-tone-02",
        _ => "agent-tone-default"
    };

    private static string AgentDescription(string code) =>
        AgentCatalog.Active.FirstOrDefault(agent => agent.Code == code)?.Description ?? "";

    private static bool WantsPdf(string text) => System.Text.RegularExpressions.Regex.IsMatch(
        TextAnalysis.Normalize(text),
        @"\bpdf\b|\b(en|como) un documento\b|\bgenera (un|el) (documento|informe|archivo)\b");

    [JSInvokable]
    public Task SendFromEnter() => Send();
    private async Task OpenAgentPanel()
    {
        agentsOpen = true;
        try
        {
            await JS.InvokeVoidAsync("docusearch.openDialog", "agent-dialog");
        }
        catch (JSException)
        {
            agentsOpen = false;
        }
        catch (JSDisconnectedException)
        {
            agentsOpen = false;
        }
    }

    private async Task CloseAgentPanel()
    {
        try { await JS.InvokeVoidAsync("docusearch.closeDialog", "agent-dialog"); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        agentsOpen = false;
    }

    private void OnAgentDialogClosed() => agentsOpen = false;

    private void Clear()
    {
        messages.Clear();
        Memory.ClearConversation(Session);
        expiresUtc = null;
        Session.LastDocumentCode = null;
        lastAgents = [];
        lastProvider = "";
        agentsOpen = false;
        scrollPending = true;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            enterBridge = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("docusearch.bindChatComposer", composer, enterBridge);
        }
        if (!scrollPending) return;
        scrollPending = false;
        await JS.InvokeVoidAsync("docusearch.scrollToEnd", conversation);
    }
    public async ValueTask DisposeAsync()
    {
        enterBridge?.Dispose();
        try { await JS.InvokeVoidAsync("docusearch.unbindChatComposer", composer); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }
}
