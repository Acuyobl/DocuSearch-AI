@inject WorkspaceState State
@inject DocumentService Service
@inject IJSRuntime JS
<div class="repository">
    <div class="repository-heading">
        <div><h1><AppIcon Name="document" />Gestión y Repositorio Documental</h1><p>Catálogo unificado de expedientes con filtrado multidimensional y control RBAC</p></div>
        <button disabled="@State.Busy" @onclick="Refresh"><AppIcon Name="refresh" />Actualizar documentos</button>
        @if (Permissions.CanWrite(State.Data!.Actor))
        {
            <button class="primary" disabled="@State.Busy" @onclick="OnUpload"><AppIcon Name="plus" />Nuevo Expediente PDF</button>
        }
    </div>
    <section class="repository-filters" aria-label="Filtros del catálogo">
        <DocumentFilters Filter="filter" OnChanged="() => page = 1" Compact="true" ShowYear="false" />
        <div class="repository-filter-summary"><span>Mostrando <strong>@Filtered.Count</strong> expedientes</span>
            @if (HasFilters) { <button class="text-button" @onclick="ClearFilters">Limpiar filtros</button> }
            <details><summary>Filtro por año@(filter.Year.Length > 0 ? $": {filter.Year}" : "")</summary><label>Año<select @bind="filter.Year" @bind:after="() => page = 1"><option value="">Todos</option>@foreach (var year in State.Data.Documents.Select(d => d.UploadDate.Year).Distinct().OrderDescending()) { <option>@year</option> }</select></label></details>
        </div>
    </section>
    <section class="repository-table" aria-label="Catálogo documental">
    <div class="table-scroll"><table>
        <thead><tr><th>Código / Título</th><th>Autor &amp; Fecha</th><th>Departamento</th><th>Categoría</th><th>Confidencialidad</th><th>Estado OCR</th><th>Acciones</th></tr></thead>
        <tbody>
        @foreach (var doc in Filtered.Skip((page - 1) * 10).Take(10))
        {
            <tr><td class="repository-document"><small class="code">@doc.InternalCode</small><button class="text-button repository-title" title="@doc.Title" @onclick="() => OnView.InvokeAsync(doc.Id)">@doc.Title</button>
                    <small class="repository-hash" title="@(doc.HasOriginal ? doc.Sha256Hash : null)">@(doc.HasOriginal ? $"Hash: {TextAnalysis.Truncate(doc.Sha256Hash, 12)}" : "Sin original")</small>
                    <div class="repository-activity"><span title="Visualizaciones en visor"><AppIcon Name="eye" />@doc.ViewsCount</span><span title="Descargas realizadas"><AppIcon Name="download" />@doc.DownloadsCount</span></div>
                </td>
                <td class="repository-author">@doc.Author<small>@doc.UploadDate.ToLocalTime().ToString("dd/MM/yyyy") (@doc.Version)</small></td>
                <td>@doc.Department</td><td><span class="repository-category">@doc.Category</span></td>
                <td><span class="repository-level @LevelClass(doc.Confidentiality)">@if (doc.Confidentiality == "Estrictamente Secreto") { <AppIcon Name="lock" /> }@doc.Confidentiality</span></td>
                <td><span class="repository-status @(doc.OcrStatus == "Completado" ? "complete" : "needs-ocr")"><AppIcon Name="@(doc.OcrStatus == "Completado" ? "check" : "refresh")" />@doc.OcrStatus</span><small>@(doc.HasOriginal ? $"PDF original · {doc.PageCount} páginas" : "Ejemplo sin PDF original")</small></td>
                <td><div class="repository-actions">
                    <button class="view-action" aria-label="Ver" title="Abrir visor contextualizado" disabled="@State.Busy" @onclick="() => OnView.InvokeAsync(doc.Id)"><AppIcon Name="eye" /></button>
                    <button aria-label="Editar" title="Editar metadatos" disabled="@(State.Busy || !Permissions.CanWrite(State.Data.Actor))" @onclick="() => OnEdit.InvokeAsync(doc)"><AppIcon Name="edit" /></button>
                    <button aria-label="Descargar" title="@(!doc.HasOriginal ? "Ejemplo sin PDF original" : Permissions.CanDownload(State.Data.Actor, doc) ? "Descargar expediente PDF" : "Descarga bloqueada por RBAC")" disabled="@(State.Busy || !doc.HasOriginal || !Permissions.CanDownload(State.Data.Actor, doc))" @onclick="() => Download(doc)"><AppIcon Name="@(Permissions.CanDownload(State.Data.Actor, doc) ? "download" : "lock")" /></button>
                    <button aria-label="Reprocesar" title="@(doc.HasOriginal ? "Reprocesar texto, resumen y entidades" : "No hay PDF original para reprocesar")" disabled="@(State.Busy || !doc.HasOriginal || !Permissions.CanWrite(State.Data.Actor))" @onclick="() => Reprocess(doc.Id)"><AppIcon Name="refresh" /></button>
                    <button class="danger" aria-label="Eliminar" title="Eliminar expediente" disabled="@(State.Busy || !Permissions.CanAdmin(State.Data.Actor))" @onclick="() => Delete(doc)"><AppIcon Name="delete" /></button>
                </div></td></tr>
        }
        @if (Filtered.Count == 0) { <tr><td colspan="7" class="empty">No se encontraron documentos que coincidan con los criterios de búsqueda.</td></tr> }
        </tbody>
    </table></div>
    @if (Filtered.Count > 10) { <div class="pagination"><button disabled="@(page <= 1)" @onclick="() => page--">Anterior</button><span>Página @(page) de @Math.Max(1, (Filtered.Count + 9) / 10)</span><button disabled="@(page * 10 >= Filtered.Count)" @onclick="() => page++">Siguiente</button></div> }
    </section>
</div>
@code {
    [Parameter] public EventCallback<string> OnView { get; set; }
    [Parameter] public EventCallback<DocumentItem> OnEdit { get; set; }
    [Parameter] public EventCallback OnUpload { get; set; }
    private DocumentFilter filter = new();
    private int page = 1;
    private List<DocumentItem> Filtered => filter.Apply(State.Data!.Documents).ToList();
    private bool HasFilters => filter.Text.Length > 0 || filter.Department.Length > 0 || filter.Category.Length > 0 || filter.Level.Length > 0 || filter.Year.Length > 0;
    protected override Task OnInitializedAsync() => Refresh();
    private Task Refresh() => State.RunAsync(async () =>
    {
        await State.RefreshAsync();
        page = Math.Min(page, Math.Max(1, (Filtered.Count + 9) / 10));
    });
    private void ClearFilters() { filter = new(); page = 1; }
    private static string LevelClass(string level) => level switch
    {
        "Estrictamente Secreto" => "secret",
        "Confidencial" => "confidential",
        "Uso Interno" => "internal",
        _ => "public"
    };
    private Task Reprocess(string id) => State.RunAsync(async () =>
    {
        await Service.ReprocessAsync(id);
        await State.RefreshAsync();
    }, "PDF reprocesado. Revisa el estado de las páginas sin texto.");
    private Task Delete(DocumentItem doc) => State.RunAsync(async () =>
    {
        if (!await JS.InvokeAsync<bool>("docusearch.confirm", $"¿Eliminar definitivamente {doc.InternalCode} y su PDF? La bitácora se conservará.")) return;
        await Service.DeleteAsync(doc.Id);
        await State.RefreshAsync();
        page = Math.Min(page, Math.Max(1, (Filtered.Count + 9) / 10));
    });
    private Task Download(DocumentItem doc) => State.RunAsync(async () =>
    {
        var bytes = await Service.FileAsync(doc.Id, true);
        using var stream = new DotNetStreamReference(new MemoryStream(bytes));
        await JS.InvokeVoidAsync("docusearch.download", stream, $"{doc.InternalCode}.pdf", "application/pdf");
        await State.RefreshAsync();
    });
}
